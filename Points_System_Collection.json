								"key": "Authorization",
								"value": "Bearer {{user_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/user/points/transactions",
							"host": ["{{base_url}}"],
							"path": ["user", "points", "transactions"]
						}
					}
				},
				{
					"name": "Get Earned Points Only",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{user_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/user/points/transactions?status=earned",
							"host": ["{{base_url}}"],
							"path": ["user", "points", "transactions"],
							"query": [
								{
									"key": "status",
									"value": "earned"
								}
							]
						}
					}
				},
				{
					"name": "Get Transactions Statistics",
					"request": {
						"method": "GET",
						"header": [
