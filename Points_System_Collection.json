{
	"info": {
		"_postman_id": "points-system-collection",
		"name": "Points System - Complete Flow",
		"description": "مجموعة شاملة لاختبار نظام النقاط والجوائز",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000/api",
			"type": "string"
		},
		{
			"key": "user_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "user_id",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1️⃣ Authentication & Registration",
			"item": [
				{
					"name": "Register New User (Get Points)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    console.log('✅ Registration successful - User should get 100 points');",
									"} else {",
									"    console.log('❌ Registration failed');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Test User Points\",\n    \"email\": \"testpoints@example.com\",\n    \"password\": \"password123\",\n    \"password_confirmation\": \"password123\",\n    \"city_id\": 1,\n    \"governorate_id\": 1\n}"
						},
						"url": {
							"raw": "{{base_url}}/user/auth/register",
							"host": ["{{base_url}}"],
							"path": ["user", "auth", "register"]
						}
					}
				},
				{
					"name": "Send OTP",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"testpoints@example.com\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/user/auth/send-otp",
							"host": ["{{base_url}}"],
							"path": ["user", "auth", "send-otp"]
						}
					}
				},
				{
					"name": "Verify OTP (Get Additional Points)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.data && response.data.token) {",
									"        pm.collectionVariables.set('user_token', response.data.token);",
									"        pm.collectionVariables.set('user_id', response.data.user.id);",
									"        console.log('✅ OTP verified - User should get verification points');",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"testpoints@example.com\",\n    \"code\": \"12345\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/user/auth/verify-otp",
							"host": ["{{base_url}}"],
							"path": ["user", "auth", "verify-otp"]
						}
					}
				},
				{
					"name": "Login Existing User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.data && response.data.token) {",
									"        pm.collectionVariables.set('user_token', response.data.token);",
									"        pm.collectionVariables.set('user_id', response.data.user.id);",
									"        console.log('✅ Login successful');",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"user@user.com\",\n    \"password\": \"password\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/user/auth/login",
							"host": ["{{base_url}}"],
							"path": ["user", "auth", "login"]
						}
					}
				}
			]
		},
		{
			"name": "2️⃣ Points Overview",
			"item": [
				{
					"name": "Get Points Summary",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    console.log('💰 Current Balance:', response.data.balance);",
									"    console.log('⏳ Pending Points:', response.data.pending_points);",
									"    console.log('💸 Redeemed Points:', response.data.redeemed_points);",
									"    console.log('⏰ Expires At:', response.data.expire_at_formatted);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{user_token}}"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/user/points/summary",
							"host": ["{{base_url}}"],
							"path": ["user", "points", "summary"]
						}
					}
				},
				{
					"name": "Get All Transactions",
					"request": {
						"method": "GET",
						"header": [
