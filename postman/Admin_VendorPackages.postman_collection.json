{
	"info": {
		"_postman_id": "vendor-packages-admin-collection",
		"name": "Admin - Vendor Packages & Subscriptions",
		"description": "كولكشن API إدارة باقات الفيندور واشتراكات الباكج للأدمن",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{admin_token}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost",
			"type": "string"
		},
		{
			"key": "admin_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "vendor_package_id",
			"value": "1",
			"type": "string"
		},
		{
			"key": "vendor_subscription_id",
			"value": "1",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Admin Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const json = pm.response.json();",
									"    if (json.data && json.data.token) {",
									"        pm.collectionVariables.set('admin_token', json.data.token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@example.com\",\n    \"password\": \"password\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/admin/auth/login",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "auth", "login"]
						},
						"description": "تسجيل دخول الأدمن للحصول على التوكن"
					}
				}
			]
		},
		{
			"name": "Vendor Packages",
			"item": [
				{
					"name": "List Vendor Packages",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/admin/vendor-packages?page=1&per_page=10&sort_field=id&sort_order=desc&is_active=1&min_price=0&max_price=1000&slug=&search=",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "vendor-packages"],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "per_page",
									"value": "10"
								},
								{
									"key": "sort_field",
									"value": "id"
								},
								{
									"key": "sort_order",
									"value": "desc"
								},
								{
									"key": "is_active",
									"value": "1",
									"description": "1=فقط النشطة، 0=غير النشطة"
								},
								{
									"key": "min_price",
									"value": "0"
								},
								{
									"key": "max_price",
									"value": "1000"
								},
								{
									"key": "slug",
									"value": ""
								},
								{
									"key": "search",
									"value": ""
								}
							]
						},
						"description": "عرض قائمة باقات الفيندور مع الفلترة والترتيب"
					}
				},
				{
					"name": "Show Vendor Package",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/admin/vendor-packages/{{vendor_package_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "vendor-packages", "{{vendor_package_id}}"]
						},
						"description": "عرض تفاصيل باكيت فيندور واحد"
					}
				},
				{
					"name": "Create Vendor Package",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": {\n        \"ar\": \"الباقة الأساسية\",\n        \"en\": \"Basic Package\"\n    },\n    \"slug\": \"basic-package\",\n    \"description\": {\n        \"ar\": \"وصف الباقة بالعربي\",\n        \"en\": \"Package description in English\"\n    },\n    \"price\": 99.99,\n    \"duration_days\": 30,\n    \"max_products\": 50,\n    \"commission_rate\": 10,\n    \"commission_per_order\": 0,\n    \"is_active\": true,\n    \"is_featured\": false,\n    \"has_premium_badge\": false,\n    \"sort_order\": 0,\n    \"search_priority\": 1,\n    \"max_campaigns\": 2,\n    \"has_banner_ad\": false,\n    \"has_sales_reports\": true,\n    \"has_analytics\": false,\n    \"report_level\": \"basic\",\n    \"order_priority\": 1,\n    \"can_set_prep_time\": true,\n    \"custom_shipping_options\": false,\n    \"has_vendor_delivery\": false,\n    \"activation_fee_waived\": false\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/admin/vendor-packages",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "vendor-packages"]
						},
						"description": "إنشاء باكيت فيندور جديد"
					}
				},
				{
					"name": "Update Vendor Package",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": {\n        \"ar\": \"الباقة الأساسية - محدثة\",\n        \"en\": \"Basic Package - Updated\"\n    },\n    \"price\": 149.99,\n    \"is_active\": true\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/admin/vendor-packages/{{vendor_package_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "vendor-packages", "{{vendor_package_id}}"]
						},
						"description": "تحديث باكيت فيندور (يمكن إرسال الحقول المطلوب تحديثها فقط)"
					}
				},
				{
					"name": "Delete Vendor Package",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/admin/vendor-packages/{{vendor_package_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "vendor-packages", "{{vendor_package_id}}"]
						},
						"description": "حذف باكيت فيندور"
					}
				}
			]
		},
		{
			"name": "Vendor Subscriptions (اشتراكات الباكج)",
			"item": [
				{
					"name": "List Vendor Subscriptions",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/admin/vendor-subscriptions?page=1&per_page=10&sort_field=id&sort_order=desc&vendor_id=&vendor_package_id=&status=&expiring_soon=&search=",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "vendor-subscriptions"],
							"query": [
								{"key": "page", "value": "1"},
								{"key": "per_page", "value": "10"},
								{"key": "sort_field", "value": "id"},
								{"key": "sort_order", "value": "desc"},
								{"key": "vendor_id", "value": "", "description": "فلتر حسب الفيندور"},
								{"key": "vendor_package_id", "value": "", "description": "فلتر حسب الباكيت"},
								{"key": "status", "value": "", "description": "active|pending|expired|cancelled"},
								{"key": "expiring_soon", "value": "", "description": "1=قريبة الانتهاء"},
								{"key": "search", "value": ""}
							]
						},
						"description": "عرض قائمة اشتراكات الباكج مع الفلترة"
					}
				},
				{
					"name": "Show Vendor Subscription",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/admin/vendor-subscriptions/{{vendor_subscription_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "vendor-subscriptions", "{{vendor_subscription_id}}"]
						},
						"description": "عرض تفاصيل اشتراك واحد"
					}
				}
			]
		}
	]
}
